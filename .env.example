# Environment Mode (development / production)
ENV=development

# Local Docker Database Connections
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/job_sandbox
REDIS_URL=redis://localhost:6379/0

# Production Cloud Free Tier Overrides (Uncomment for cloud deployment)
# DATABASE_URL=postgresql+asyncpg://postgres:your-supabase-pass@db.xxxx.supabase.co:5432/postgres
# REDIS_URL=rediss://default:your-upstash-pass@xxxx.upstash.io:6379

# Scraper Settings
HEADLESS_MODE=true
MAX_CONCURRENT_SCRAPES=3
SCRAPE_DELAY_SECONDS=2.5
